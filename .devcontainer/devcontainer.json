{
  "name": "Omnivance Expense Tracker",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Omnivance Web App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "cd server && npm install",
  "postStartCommand": "cd server && npm start"
}
